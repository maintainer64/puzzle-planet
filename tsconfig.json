{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node"], "paths": { "@/*": ["./*"] }
  },
  "include": ["src", "server", "lib", "components", "tests", "vite.config.ts"]
}
